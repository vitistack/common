# Build the NetworkNamespace conversion webhook (hub: v1alpha3)
FROM golang:1.27-alpine AS builder
ARG TARGETOS
ARG TARGETARCH

WORKDIR /workspace
COPY go.mod go.mod
COPY go.sum go.sum
RUN go mod download

COPY cmd/networknamespace-webhook/ cmd/networknamespace-webhook/
COPY pkg/ pkg/
COPY internal/ internal/

RUN CGO_ENABLED=0 GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH} go build -a -o webhook-server ./cmd/networknamespace-webhook

FROM gcr.io/distroless/static:nonroot
WORKDIR /
COPY --from=builder /workspace/webhook-server .
USER 65532:65532

ENTRYPOINT ["/webhook-server"]
